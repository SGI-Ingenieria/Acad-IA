{
  "if": {
    "anyOf": [
      {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/disks"
          },
          {
            "field": "Microsoft.Compute/disks/sku.name",
            "in": [
              "Premium_LRS",
              "Premium_ZRS",
              "PremiumV2_LRS",
              "UltraSSD_LRS"
            ]
          }
        ]
      },
      {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachineScaleSets"
          },
          {
            "field": "Microsoft.Compute/virtualMachineScaleSets/virtualMachineProfile.storageProfile.osDisk.diffDiskSettings.option",
            "notEquals": "Local"
          }
        ]
      }
    ]
  },
  "then": {
    "effect": "deny"
  }
}
